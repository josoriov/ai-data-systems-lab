  "cards": [
    {
      "dot": "emerald",
      "title": "Lending analytics",
      "items": [
        "Python owns loading, dbt execution and CSV export.",
        "DuckDB stores raw, Silver and Gold tables locally.",
        "Ten models · 49 data tests · cutoff 2026-06-30."
      ]
    },
    {
      "dot": "rose",
      "title": "Grounded message triage",
      "items": [
        "The model proposes; Python checks evidence and policy coverage.",
        "Detected fraud and account-specific cases require human handling.",
        "Reports record reply, handoff or discard decisions; no tickets are sent."
      ]
    },
    {
      "dot": "cyan",
      "title": "Reproducible local prototypes",
      "items": [
        "Recorded outputs and offline checks need no API key.",
        "Live calls send message text with store=False; sender is omitted.",
        "API failures stay visible as error rows in the report."
      ]
    }
  ]
